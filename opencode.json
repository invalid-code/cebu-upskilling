{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh-grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "fetch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    },
    "git": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-git"
      ]
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {}
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "environment": {
        "POSTGRES_URL": "{env:DATABASE_URL}"
      }
    },
    "vercel": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "vercel-mcp"
      ],
      "environment": {
        "VERCEL_TOKEN": "{env:VERCEL_TOKEN}"
      }
    },
    "figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp"
      ],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      }
    }
  },
  "agent": {
    "deployment-engineer": {
      "steps": 15
    },
    "platform-engineer": {
      "steps": 15
    },
    "sre-engineer": {
      "steps": 15
    },
    "code-reviewer": {
      "steps": 15
    },
    "dependency-manager": {
      "steps": 10
    },
    "docs-writer": {
      "steps": 10
    },
    "git-workflow-manager": {
      "steps": 8
    },
    "technical-writer": {
      "steps": 10
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  }
}
