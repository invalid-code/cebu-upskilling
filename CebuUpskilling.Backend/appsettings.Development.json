{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "System.Net.Http": "Warning",
        "CebuUpskilling.Backend.Services": "Debug",
        "CebuUpskilling.Backend.Controllers": "Debug",
        "CebuUpskilling.Backend.Handlers": "Debug"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false,
        "ColorBehavior": "Enabled"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "CebuUpskilling",
    "Audience": "CebuUpskillingClient"
  }
}